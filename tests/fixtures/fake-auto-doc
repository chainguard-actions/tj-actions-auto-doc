#!/bin/sh
# Fake auto-doc binary for testing
# Parses --filename and --output args and writes fake documentation

FILENAME="action.yml"
OUTPUT="README.md"

for arg in "$@"; do
  case "$arg" in
    --filename=*) FILENAME="${arg#--filename=}" ;;
    --output=*) OUTPUT="${arg#--output=}" ;;
  esac
done

# Write fake documentation to the output file
cat > "$OUTPUT" << 'EOF'
<!-- AUTO-DOC-INPUT:START - Do not remove or modify this section -->
| INPUT | TYPE | REQUIRED | DEFAULT | DESCRIPTION |
|-------|------|----------|---------|-------------|
| filename | String | false | `"action.yml"` | Path to the yaml file |
<!-- AUTO-DOC-INPUT:END -->
EOF

echo "auto-doc: generated documentation from $FILENAME to $OUTPUT"
exit 0
