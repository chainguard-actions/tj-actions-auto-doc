#!/bin/sh
# Fake auto-doc binary: verifies reusable column flags are passed
ARGS="$*"
FILENAME=""
OUTPUT=""
REUSABLE_FLAG=""
REUSABLE_INPUT_COLUMNS_FOUND=""
REUSABLE_OUTPUT_COLUMNS_FOUND=""
REUSABLE_SECRET_COLUMNS_FOUND=""

for arg in "$@"; do
  case "$arg" in
    --filename=*) FILENAME="${arg#--filename=}" ;;
    --output=*) OUTPUT="${arg#--output=}" ;;
    --reusable) REUSABLE_FLAG="true" ;;
    --reusableInputColumns=*) REUSABLE_INPUT_COLUMNS_FOUND="${arg#--reusableInputColumns=}" ;;
    --reusableOutputColumns=*) REUSABLE_OUTPUT_COLUMNS_FOUND="${arg#--reusableOutputColumns=}" ;;
    --reusableSecretColumns=*) REUSABLE_SECRET_COLUMNS_FOUND="${arg#--reusableSecretColumns=}" ;;
  esac
done

echo "fake-auto-doc args: $ARGS"
echo "reusableInputColumns: $REUSABLE_INPUT_COLUMNS_FOUND"
echo "reusableOutputColumns: $REUSABLE_OUTPUT_COLUMNS_FOUND"
echo "reusableSecretColumns: $REUSABLE_SECRET_COLUMNS_FOUND"

if [ -z "$REUSABLE_INPUT_COLUMNS_FOUND" ]; then
  echo "ERROR: --reusableInputColumns was not passed to binary"
  exit 1
fi

if [ -z "$REUSABLE_OUTPUT_COLUMNS_FOUND" ]; then
  echo "ERROR: --reusableOutputColumns was not passed to binary"
  exit 1
fi

if [ -z "$REUSABLE_SECRET_COLUMNS_FOUND" ]; then
  echo "ERROR: --reusableSecretColumns was not passed to binary"
  exit 1
fi

if [ "$REUSABLE_FLAG" != "true" ]; then
  echo "ERROR: --reusable flag was not passed to binary"
  exit 1
fi

if [ -n "$OUTPUT" ]; then
  cat > "$OUTPUT" <<MDEOF
# Reusable Columns Workflow

<!-- AUTO-DOC-INPUT:START - Do not edit this section. -->
| Input | Description |
|-------|-------------|
| environment | The environment to deploy to |
<!-- AUTO-DOC-INPUT:END -->

<!-- AUTO-DOC-OUTPUT:START - Do not edit this section. -->
| Output | Description |
|--------|-------------|
| deploy-url | The deployed URL |
<!-- AUTO-DOC-OUTPUT:END -->

<!-- AUTO-DOC-SECRETS:START - Do not edit this section. -->
| Secret | Description |
|--------|-------------|
| deploy-token | Token for deployment |
<!-- AUTO-DOC-SECRETS:END -->
MDEOF
fi
exit 0
